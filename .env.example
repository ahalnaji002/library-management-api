# Local-only values. Replace the password before starting PostgreSQL.
PORT=3000
POSTGRES_USER=library_user
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_DB=library_dev

# The API and Prisma CLI connect from the host through Compose's localhost port.
DATABASE_URL=postgresql://library_user:replace-with-a-unique-local-password@localhost:5433/library_dev?schema=public
